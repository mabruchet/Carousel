<?xml version="1.0" encoding="UTF-8" ?>

<routes xmlns="http://symfony.com/schema/routing"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/routing http://symfony.com/schema/routing/routing-1.0.xsd">

    <route id="carousel.create" path="/admin/module/carousel/create" methods="post">
        <default key="_controller">Carousel\Controller\ConfigurationController::createSlide</default>
    </route>

    <route id="carousel.edit" path="/admin/module/carousel/edit/{slideId}" methods="get">
        <default key="_controller">Carousel\Controller\ConfigurationController::editSlide</default>
        <requirement key="slideId">\d+</requirement>
    </route>

    <route id="carousel.save" path="/admin/module/carousel/edit/{slideId}" methods="post">
        <default key="_controller">Carousel\Controller\ConfigurationController::saveSlide</default>
        <requirement key="slideId">\d+</requirement>
    </route>

    <route id="carousel.image.upload" path="/admin/module/carousel/image/{slideId}/{variant}" methods="post">
        <default key="_controller">Carousel\Controller\ConfigurationController::uploadImage</default>
        <requirement key="slideId">\d+</requirement>
        <requirement key="variant">desktop|mobile</requirement>
    </route>

    <route id="carousel.update_position" path="/admin/module/carousel/update-position" methods="post">
        <default key="_controller">Carousel\Controller\ConfigurationController::updatePosition</default>
    </route>

    <route id="carousel.toggle" path="/admin/module/carousel/toggle-visible/{slideId}" methods="get">
        <default key="_controller">Carousel\Controller\ConfigurationController::toggleVisibility</default>
        <requirement key="slideId">\d+</requirement>
    </route>

    <route id="carousel.delete" path="/admin/module/carousel/delete" methods="post">
        <default key="_controller">Carousel\Controller\ConfigurationController::deleteSlide</default>
    </route>

    <route id="carousel.front.preview" path="/carousel-preview/{group}" methods="get">
        <default key="_controller">Carousel\Controller\Front\PreviewController::preview</default>
        <requirement key="group">[\w-]{1,64}</requirement>
    </route>

</routes>
